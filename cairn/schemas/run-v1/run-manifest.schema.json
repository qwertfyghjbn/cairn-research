{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.local/schemas/run-v1/run-manifest.schema.json",
  "title": "Cairn Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "run_state",
    "task",
    "system",
    "model",
    "workers",
    "prompts",
    "environment",
    "budget",
    "timeouts",
    "retry_policy",
    "evaluator_version",
    "random_seed",
    "started_at",
    "finished_at",
    "instrumentation"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/id" },
    "experiment_id": { "$ref": "#/$defs/id" },
    "run_state": { "enum": ["finished", "interrupted"] },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_hash", "challenge_version"],
      "properties": {
        "task_id": { "$ref": "#/$defs/id" },
        "task_hash": { "$ref": "#/$defs/sha256" },
        "challenge_version": { "type": "string", "minLength": 1 }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_version", "git_commit", "baseline_id", "contract_version"],
      "properties": {
        "system_version": { "$ref": "#/$defs/id" },
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseline_id": { "$ref": "#/$defs/id" },
        "contract_version": { "type": "integer", "minimum": 1 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id", "model_version", "parameters", "endpoint_type", "provider_supports_seed"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_version": { "type": ["string", "null"], "minLength": 1 },
        "parameters": { "type": "object" },
        "endpoint_type": { "type": "string", "minLength": 1 },
        "provider_supports_seed": { "type": "boolean" }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "configuration"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "configuration": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "task_types", "priority", "max_running", "cli_version", "session_mode"],
            "properties": {
              "name": { "$ref": "#/$defs/id" },
              "type": { "type": "string", "minLength": 1 },
              "task_types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["bootstrap", "reason", "explore"] }
              },
              "priority": { "type": "integer" },
              "max_running": { "type": "integer", "minimum": 1 },
              "cli_version": { "type": ["string", "null"], "minLength": 1 },
              "session_mode": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_group", "hashes"],
      "properties": {
        "prompt_group": { "type": "string", "minLength": 1 },
        "hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "os",
        "python_version",
        "uv_version",
        "container_digests",
        "network_mode",
        "capabilities",
        "tool_permissions",
        "public_environment",
        "cleanup_policy"
      ],
      "properties": {
        "execution_mode": { "enum": ["container", "local"] },
        "os": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "minLength": 1 },
        "uv_version": { "type": "string", "minLength": 1 },
        "container_digests": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "network_mode": { "type": ["string", "null"], "minLength": 1 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tool_permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "public_environment": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "cleanup_policy": { "type": "string", "minLength": 1 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "llm_calls", "input_tokens", "output_tokens", "cost_usd", "price_table_version"],
      "properties": {
        "wall_clock_seconds": { "type": "integer", "minimum": 1 },
        "llm_calls": { "type": ["integer", "null"], "minimum": 1 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "price_table_version": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_seconds", "bootstrap_conclude_seconds", "reason_seconds", "explore_seconds", "explore_conclude_seconds"],
      "properties": {
        "bootstrap_seconds": { "type": "integer", "minimum": 1 },
        "bootstrap_conclude_seconds": { "type": "integer", "minimum": 1 },
        "reason_seconds": { "type": "integer", "minimum": 1 },
        "explore_seconds": { "type": "integer", "minimum": 1 },
        "explore_conclude_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backoff"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "backoff": { "type": "string", "minLength": 1 }
      }
    },
    "evaluator_version": { "$ref": "#/$defs/id" },
    "random_seed": { "type": ["string", "integer", "null"] },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "instrumentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "overhead_capture"],
      "properties": {
        "version": { "$ref": "#/$defs/id" },
        "overhead_capture": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
