{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.local/schemas/run-v1/graph-snapshot.schema.json",
  "title": "Cairn Graph Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "snapshot_id",
    "snapshot_type",
    "captured_at",
    "last_event_sequence",
    "source_schema",
    "project",
    "facts",
    "intents",
    "hints"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/id" },
    "snapshot_id": { "$ref": "#/$defs/id" },
    "snapshot_type": { "enum": ["initial", "checkpoint", "final"] },
    "captured_at": { "$ref": "#/$defs/timestamp" },
    "last_event_sequence": { "type": "integer", "minimum": 0 },
    "source_schema": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "bootstrap_enabled", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "status": { "enum": ["active", "stopped", "completed"] },
        "bootstrap_enabled": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "description": { "type": "string" }
        }
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "description", "creator", "worker", "last_heartbeat_at", "created_at", "concluded_at"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "from": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "to": {
            "anyOf": [
              { "$ref": "#/$defs/id" },
              { "type": "null" }
            ]
          },
          "description": { "type": "string" },
          "creator": { "type": "string", "minLength": 1 },
          "worker": {
            "anyOf": [
              { "$ref": "#/$defs/id" },
              { "type": "null" }
            ]
          },
          "last_heartbeat_at": {
            "anyOf": [
              { "$ref": "#/$defs/timestamp" },
              { "type": "null" }
            ]
          },
          "created_at": { "$ref": "#/$defs/timestamp" },
          "concluded_at": {
            "anyOf": [
              { "$ref": "#/$defs/timestamp" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content", "creator", "created_at"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "content": { "type": "string" },
          "creator": { "type": "string", "minLength": 1 },
          "created_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
