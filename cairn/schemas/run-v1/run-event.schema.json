{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.local/schemas/run-v1/run-event.schema.json",
  "title": "Cairn Run Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "event_id",
    "sequence",
    "event_type",
    "timestamp",
    "monotonic_ms",
    "worker_id",
    "task_id",
    "parent_event_id",
    "related_fact_ids",
    "related_intent_ids",
    "related_artifact_ids",
    "token_usage",
    "cost_usd",
    "duration_ms",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/id" },
    "event_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": [
        "run_started",
        "run_finished",
        "worker_started",
        "worker_stopped",
        "llm_call_started",
        "llm_call_completed",
        "tool_call_started",
        "tool_call_completed",
        "fact_created",
        "fact_read",
        "fact_referenced",
        "intent_created",
        "intent_claimed",
        "intent_completed",
        "intent_abandoned",
        "artifact_created",
        "artifact_read",
        "flag_candidate",
        "flag_submitted",
        "flag_accepted",
        "runtime_error",
        "budget_exhausted"
      ]
    },
    "timestamp": { "$ref": "#/$defs/timestamp" },
    "monotonic_ms": { "type": "integer", "minimum": 0 },
    "worker_id": {
      "anyOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "task_id": { "$ref": "#/$defs/id" },
    "parent_event_id": {
      "anyOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "related_fact_ids": { "$ref": "#/$defs/id_array" },
    "related_intent_ids": { "$ref": "#/$defs/id_array" },
    "related_artifact_ids": { "$ref": "#/$defs/id_array" },
    "token_usage": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "total_tokens", "source"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 },
            "source": { "enum": ["provider", "estimated"] }
          }
        },
        { "type": "null" }
      ]
    },
    "cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "run_started" } } },
      "then": { "properties": { "payload": { "required": ["system_version"] } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "run_finished" } } },
      "then": { "properties": { "payload": { "required": ["termination_reason"] } } }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["worker_started", "worker_stopped"] } } },
      "then": {
        "properties": {
          "worker_id": { "$ref": "#/$defs/id" },
          "payload": { "required": ["worker_type"] }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["llm_call_started", "llm_call_completed"] } } },
      "then": {
        "properties": {
          "worker_id": { "$ref": "#/$defs/id" },
          "payload": { "required": ["call_id", "model_id", "phase"] }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["tool_call_started", "tool_call_completed"] } } },
      "then": {
        "properties": {
          "worker_id": { "$ref": "#/$defs/id" },
          "payload": { "required": ["call_id", "tool_name"] }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["fact_created", "fact_read", "fact_referenced"] } } },
      "then": { "properties": { "payload": { "required": ["fact_id"] } } }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["intent_created", "intent_claimed", "intent_completed", "intent_abandoned"] } } },
      "then": { "properties": { "payload": { "required": ["intent_id"] } } }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["artifact_created", "artifact_read"] } } },
      "then": { "properties": { "payload": { "required": ["artifact_id"] } } }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["flag_candidate", "flag_submitted", "flag_accepted"] } } },
      "then": { "properties": { "payload": { "required": ["submission_id"] } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "runtime_error" } } },
      "then": { "properties": { "payload": { "required": ["category", "message", "retryable"] } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "budget_exhausted" } } },
      "then": { "properties": { "payload": { "required": ["budget_type", "limit", "observed"] } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  }
}
